#!/usr/bin/python3 -I
# seed-hook-allowlist: OWNER-RUN, run once, BEFORE the first Hermes start and BEFORE the uchg freeze.
# Run as:  /usr/bin/python3 -I seed-hook-allowlist     (stdlib only; never reads tokens/env files; never starts Hermes)
# Writes <HERMES_HOME>/shell-hooks-allowlist.json with the ONE documented hook, in the exact format of Hermes's own
# agent/shell_hooks.py _record_approval + save_allowlist (@908e4a4): {"approvals":[{event,command,approved_at,
# script_mtime_at_approval}]}, json.dumps(indent=2, ensure_ascii=False, sort_keys=True), no trailing newline, mode 600,
# mkstemp-beside + fchmod + fsync + os.replace (utils.py atomic_json_write). Deliberately takes NO flock/.lock: the
# process check below guarantees no Hermes is running, and the helper must leave no extra files.
import hashlib, json, os, re, stat, subprocess, sys, tempfile, shutil
from datetime import datetime, timezone

H = os.path.expanduser("~/claude-profiles/hermes")          # the one constant a scratch copy retargets
HERMES_HOME_EXPECT = H + "/h1-home"
CODE = H + "/hermes-agent"
HOOK = H + "/bin/pre-tool-call.sh"
# evidence sha of pre-tool-call.sh; update with the hook
HOOK_SHA256 = "edd56ad206e2125f1512967533532e893fbd77736fbd942eefba2d81ad890209"
EVENT = "pre_tool_call"
FILENAME = "shell-hooks-allowlist.json"


def refuse(why):
    print("seed-hook-allowlist: refused: " + why, file=sys.stderr)
    sys.exit(1)


def utc_iso(dt):  # same as shell_hooks._utc_now_iso / script_mtime_iso formatting
    return dt.isoformat().replace("+00:00", "Z")


def hermes_running():
    """Precise 'Hermes process' test: any process other than this one and its ancestors whose argv contains the code-dir
    path or the bundled-python path <HERMES_HOME>/tools/python-*. Fail closed on any error."""
    try:
        out = subprocess.run(["/bin/ps", "-axww", "-o", "pid=,ppid=,command="], capture_output=True, text=True, timeout=20, check=True).stdout
    except Exception:
        refuse("process check failed (ps error); cannot prove no Hermes process is running")
    procs = {}
    for ln in out.splitlines():
        m = re.match(r"\s*(\d+)\s+(\d+)\s+(.*)$", ln)
        if m:
            procs[int(m.group(1))] = (int(m.group(2)), m.group(3))
    if os.getpid() not in procs:
        refuse("process check failed (own pid not in ps output)")
    skip, p = set(), os.getpid()
    while p and p not in skip:
        skip.add(p)
        p = procs.get(p, (0, ""))[0]
    pats = [re.compile(re.escape(CODE) + r"(?=/|\s|$)"), re.compile(re.escape(HERMES_HOME_EXPECT + "/tools/python-"))]
    return any(any(r.search(cmd) for r in pats) for pid, (_pp, cmd) in procs.items() if pid not in skip)


def main():
    hh = os.environ.get("HERMES_HOME")
    if not hh:
        refuse("HERMES_HOME not set")
    if hh != HERMES_HOME_EXPECT:
        refuse("HERMES_HOME is not " + HERMES_HOME_EXPECT)
    if not os.path.isdir(hh) or os.path.islink(hh):
        refuse("HERMES_HOME dir missing or a symlink")
    try:
        st = os.lstat(HOOK)
    except OSError:
        refuse("hook missing: " + HOOK)
    if not stat.S_ISREG(st.st_mode):
        refuse("hook is not a regular file")
    if stat.S_IMODE(st.st_mode) != 0o555:
        refuse("hook mode is %o, not 555" % stat.S_IMODE(st.st_mode))
    with open(HOOK, "rb") as f:
        if hashlib.sha256(f.read()).hexdigest() != HOOK_SHA256:
            refuse("hook sha256 differs from the evidence sha")
    if hermes_running():
        refuse("a Hermes process is running (stop it first)")

    target = os.path.join(hh, FILENAME)
    existing = None
    try:
        tst = os.lstat(target)
    except FileNotFoundError:
        tst = None
    except OSError:
        refuse("cannot stat existing allowlist")
    if tst is not None:
        if not stat.S_ISREG(tst.st_mode):
            refuse("existing allowlist is not a regular file")
        try:
            with open(target, encoding="utf-8-sig") as f:
                existing = json.load(f)
        except Exception:
            refuse("existing allowlist does not parse as JSON")
        if not isinstance(existing, dict) or set(existing) - {"approvals"} or not isinstance(existing.get("approvals"), list):
            refuse("existing allowlist has an unexpected structure")
        ap = existing["approvals"]
        ok = [e for e in ap if isinstance(e, dict) and e.get("event") == EVENT and e.get("command") == HOOK]
        if len(ap) != len(ok) or len(ok) > 1:
            refuse("existing allowlist holds approvals other than the single documented hook (%d entries)" % len(ap))
        stamp = datetime.now(tz=timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        bak = target + ".bak-" + stamp
        if os.path.lexists(bak):
            refuse("backup name already exists")
        shutil.copy2(target, bak)  # cp -p: mode/mtime preserved; BEFORE any write

    entry = {
        "event": EVENT,
        "command": HOOK,
        "approved_at": utc_iso(datetime.now(tz=timezone.utc)),
        "script_mtime_at_approval": utc_iso(datetime.fromtimestamp(os.path.getmtime(HOOK), tz=timezone.utc)),
    }
    text = json.dumps({"approvals": [entry]}, indent=2, ensure_ascii=False, sort_keys=True)
    fd, tmp = tempfile.mkstemp(dir=hh, prefix=".shell-hooks-allowlist_", suffix=".tmp")  # 0600 from creation
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            os.fchmod(f.fileno(), 0o600)
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, target)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    print(target)
    print("seeded")


main()
