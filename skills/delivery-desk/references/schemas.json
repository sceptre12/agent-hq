  "reason_codes": {
    "sender": {"class": "terminal", "b3_step": 1, "trigger": "transport sender not in the desk-held registry for the run; a conductor-only verb whose sender is not the registered conductor or whose <id> subtask is not run; any <id> with <subtask> run whose transport sender is not the registry's run id. No .out is written."},
    "schema": {"class": "terminal", "b3_step": 5, "trigger": "the copy fails the closed per-verb schema: unknown verb, unknown or missing field, raw flag, force, string where an array is required, id/verb/subtask in the JSON differing from the line (including a relayed claude -p request whose subtask does not match the id); also a DESK path not equal to RUN_HOME/desk/<id>.req, a <verb> outside the 20 B4 verbs (approve, trigger-prod, pipeline-edit included: they are not verbs, so check 5 refuses them before check 6), and a ref, base, merged_into, tag or package starting with - (raw flag); a jira-create with no parent for a non-Epic, and an int written as -0 or in exponent form (B9 26, PR10-R2)"},
    "hash": {"class": "terminal", "b3_step": 4, "trigger": "the copy's sha256 differs from sha256=<hex>"},
    "repo": {"class": "terminal", "b3_step": 6, "trigger": "repo not under a registered clone (resolves to no profile); pr-merge method differs from the profile merge_method (AM-8 V7); branch fails <JIRA-KEY>(-[a-z0-9-]+)?; body_path, payload_path, record_path or an attachment path outside its allowed root"},
    "marker": {"class": "curable", "b3_step": 8, "trigger": "a re-derived marker fails: jira-create parent missing at re-fetch (AM-8 V7); head sha, CODE-GATE-REVIEW/Verified-By, H-pr approval, CI not green at pr-merge, GATE-PASS record missing for a push or pr-create, branch-delete content not merged into merged_into; also push-spacing and pipeline-bound (detail)"},
    "order": {"class": "curable", "b3_step": 8, "trigger": "a pr-merge predecessor is not merged"},
    "policy": {"class": "terminal", "b3_step": 6, "$comment": "approve, trigger-prod and pipeline edit are quoted from part B2.1; as DESK verbs they never reach check 6 (a non-B4 verb is schema at check 5, part B2 and B3 step 5), so in practice policy is for in-schema requests: ci-rerun on a non-pull-request run, a tag-push the profile refuses, a redaction hit or an unusable pattern file, a test-report-push first call with dry_run false", "trigger": "an in-schema request the desk never grants (ci-rerun on a non-pull-request run; non-B4 verbs such as approve, trigger-prod or pipeline edit are schema at check 5, not policy); a tag-push the repo profile does not allow (no release_tags entry, used \"no\", tag not matching pattern, malformed entry); a redaction hit in a body, payload, attachment or string field; a test-report-push whose first call for a payload_path carries dry_run false (B9 26)"},
    "stale-session": {"class": "curable", "b3_step": 7, "trigger": "the GitHub or Atlassian session is not fresh", "$comment": "curable: resent with a fresh id on the owner's word (B9 29-33); unrelated to the A.3 stop_reason stale-session of a second pm lead (A.8)"},
    "gate-missing": {"class": "curable", "b3_step": 8, "trigger": "H1.<run-id>.ok absent before jira-create; H-prod.<step_id>.<run-id>.ok absent before publish, or before a tag-push under release_tags.approval human; merge_reach row absent before pr-merge"},
    "action-failed": {"class": "curable", "b3_step": 9, "trigger": "a valid request whose action then fails (non-fast-forward, branch protection, remote or gh error); .inflight stays"}
  },
  "regexes": {
    "$comment": "POSIX ERE (INTERFACES Regex dialect); copied from part B. These lines are not verbs (RESOLVED Q2).",
    "id": "^([a-z0-9-]+)-(st[0-9]+|pm|run)-([0-9]{8}T[0-9]{6}Z)-([0-9]+)$",
    "run_subtask_prefix": "^[a-z][a-z0-9]*-[0-9]+-[0-9]{8}(-[0-9]+)?-(st[0-9]+|pm|run)$",
    "DESK": "^DESK +([a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+) \\| ([a-z-]+) \\| (/[^ ]+) \\| sha256=([0-9a-f]{64})$",
    "DONE": "^DONE +([a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+) \\| ([a-z-]+) \\| result=(/[^ ]+) \\| ([^|[:cntrl:]]+)$",
    "REJECTED": "^REJECTED +([a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+) \\| (sender|schema|hash|repo|marker|order|policy|stale-session|gate-missing|action-failed)$",
    "REGISTER-SENDER": "^REGISTER-SENDER ([a-z0-9-]+) \\| (st[0-9]+|pm|run) \\| ([^ ]+)$",
    "REGISTERED": "^REGISTERED ([a-z0-9-]+) \\| (st[0-9]+|pm|run) \\| (ok|refused)$",
    "GATE": "^GATE ([a-z0-9-]+) (H0|H1|H-e2e\\.(st[0-9]+|pm)|H-pr|H-prod\\.[a-z0-9-]+|grant\\.(st[0-9]+|pm)\\.[0-9]+|H-destructive\\.[A-Za-z0-9.-]+|RESUME\\.(st[0-9]+|pm)) (ok|changes|reject)( .+)?$",
    "ANSWER": "^ANSWER ([a-z0-9-]+) (st[0-9]+|pm) ([ui][0-9]+) (.+)$",
    "REBIND": "^REBIND ([a-z0-9-]+) ([^ ]+)$",
    "VERDICT": "^VERDICT ([a-z0-9-]+) pm ([A-Za-z0-9.-]+) (.+)$",
    "STATUS": "^STATUS +([a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+)$",
    "BUSY": "^BUSY ([a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+) \\| ([^|[:cntrl:]]+) \\| ([^|[:cntrl:]]+)$",
    "status_busy_source": "STATUS and BUSY are the permission-tiers-02 section 2 envelope lines (architecture/permission-tiers-02.md:92 grammar, :100-101 2-minute rule), not part B; the id group reuses the B2 id; the regex form is an author default",
    "desk_address": "^desk$",
    "conductor_only_verbs": "^(pr-merge|publish|tag-push|test-report-push)$",
    "gate_verdicts": {"H0": ["ok"], "H1": ["ok", "changes", "reject"], "H-e2e.<subtask>": ["ok"], "H-prod.<step_id>": ["ok"], "H-pr": [], "grant.<subtask>.<n>": ["ok"], "H-destructive.<row-id>": ["ok"], "RESUME.<subtask>": ["ok"]},
    "gate_source": "B8 plus the B9 gate lines (AM-5 26, 21, queue row 29): grant.<subtask>.<n>, H-destructive.<row-id> (row id as D2.2 row 12, [A-Za-z0-9.-]+), RESUME.<subtask>; B9 GATE lines carry <run-id> in the B8 form GATE <run-id> <gate> ... (INTERFACES 1.6.0 AM-6 (f)) so the run resolves; a grant line's text must start with ref=<sensitive path> (DEFAULT (author))",
    "gate_file": "^(H0|H1|H-e2e\\.(st[0-9]+|pm)|H-prod\\.[a-z0-9-]+|grant\\.(st[0-9]+|pm)\\.[0-9]+|H-destructive\\.[A-Za-z0-9.-]+|RESUME\\.(st[0-9]+|pm))\\.([a-z0-9-]+)\\.(ok|changes|reject)$",
    "gate_file_source": "A.2.1 AM-5 26: every gate-file name is <gate>.<run-id>.<verdict>; H-e2e under RUN_HOME/<subtask>/gates/, the rest under RUN_HOME/gates/; only .ok satisfies a gate; changes and reject exist for H1 only"
  }
}
