{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "delivery-desk/references/schemas.json",
 "$comment": "Machine-readable copy of INTERFACES 1.2.0 part B (B1, B2, B2.1, B4, B6, B8); part B is the authority. verbs.<verb>.request validates the .req 'fields' object; verbs.<verb>.result validates a DONE .out; envelope alone validates a REJECTED .out.",
 "interfaces_version": "1.2.0",
 "definitions": {
  "abs_path": {
   "type": "string",
   "pattern": "^/[^\\u0000-\\u001f\\u007f]+$",
   "$comment": "absolute path; the desk realpaths it under the root named in the B4 per-field rules"
  },
  "repo": {
   "type": "string",
   "pattern": "^/[^\\u0000-\\u001f\\u007f]+$",
   "$comment": "abs path; realpath under a registered clone (B3 step 6, else repo)"
  },
  "branch": {
   "type": "string",
   "pattern": "^[A-Z][A-Z0-9]+-[0-9]+(-[a-z0-9-]+)?$"
  },
  "git_ref": {
   "type": "string",
   "pattern": "^[A-Za-z0-9._/-]+$"
  },
  "pr": {
   "type": "integer",
   "minimum": 1
  },
  "ci_run_id": {
   "type": "integer",
   "minimum": 1
  },
  "sha40": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "fields_subtask": {
   "type": "string",
   "pattern": "^(st[0-9]+|pm)$"
  },
  "envelope_subtask": {
   "type": "string",
   "pattern": "^(st[0-9]+|pm|run)$"
  },
  "label": {
   "type": "string",
   "pattern": "^[A-Za-z0-9._:-]+$"
  },
  "job": {
   "type": "string",
   "pattern": "^[^\\u0000-\\u001f\\u007f]{1,200}$"
  },
  "tag": {
   "type": "string",
   "pattern": "^[A-Za-z0-9._/-]+$"
  },
  "package": {
   "type": "string",
   "pattern": "^(@[a-z0-9-]+/)?[a-z0-9._-]+$"
  },
  "semver": {
   "type": "string",
   "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
  },
  "step_id": {
   "type": "string",
   "pattern": "^[a-z0-9-]+$"
  },
  "jira_key": {
   "type": "string",
   "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
  },
  "method": {
   "enum": [
    "squash",
    "merge",
    "rebase"
   ],
   "$comment": "must also equal the profile merge_method (B4)"
  },
  "transition_to": {
   "enum": [
    "Backlog",
    "In Progress",
    "In Review",
    "Blocked",
    "Verified",
    "Done",
    "archive"
   ],
   "$comment": "D3 canonical status or archive (profile jira.archive_status)"
  },
  "str_or_strs": {
   "oneOf": [
    {
     "type": "string"
    },
    {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   ]
  },
  "jira_fields_write": {
   "type": "object",
   "additionalProperties": false,
   "minProperties": 1,
   "properties": {
    "summary": {
     "$ref": "#/definitions/str_or_strs"
    },
    "description": {
     "$ref": "#/definitions/str_or_strs"
    },
    "issuetype": {
     "$ref": "#/definitions/str_or_strs"
    },
    "parent": {
     "$ref": "#/definitions/str_or_strs"
    },
    "labels": {
     "$ref": "#/definitions/str_or_strs"
    },
    "priority": {
     "$ref": "#/definitions/str_or_strs"
    },
    "components": {
     "$ref": "#/definitions/str_or_strs"
    }
   },
   "$comment": "closed Jira write allowlist (B4, card 14, M29)"
  },
  "jira_readable_name": {
   "enum": [
    "summary",
    "description",
    "issuetype",
    "parent",
    "labels",
    "priority",
    "components",
    "status"
   ]
  },
  "jira_fields_read": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "summary": {
     "$ref": "#/definitions/str_or_strs"
    },
    "description": {
     "$ref": "#/definitions/str_or_strs"
    },
    "issuetype": {
     "$ref": "#/definitions/str_or_strs"
    },
    "parent": {
     "$ref": "#/definitions/str_or_strs"
    },
    "labels": {
     "$ref": "#/definitions/str_or_strs"
    },
    "priority": {
     "$ref": "#/definitions/str_or_strs"
    },
    "components": {
     "$ref": "#/definitions/str_or_strs"
    },
    "status": {
     "$ref": "#/definitions/str_or_strs"
    }
   }
  },
  "https_url": {
   "type": "string",
   "pattern": "^https://[^\\s]+$"
  },
  "utc": {
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  },
  "ci_state": {
   "enum": [
    "success",
    "failure",
    "pending",
    "skipped",
    "cancelled"
   ]
  },
  "request_file": {
   "$comment": "RUN_HOME/desk/<id>.req as written by desk-req.sh (B3 sender step); id, verb, subtask are cross-checked against the DESK line on the hashed copy (B3 step 5, else schema)",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "verb",
    "subtask",
    "fields"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"
    },
    "verb": {
     "enum": [
      "push",
      "pr-create",
      "pr-attach",
      "pr-comment",
      "pr-comments-read",
      "pr-approval-state",
      "pr-merge",
      "branch-delete",
      "ci-status",
      "ci-logs",
      "ci-rerun",
      "ci-status-main",
      "fetch",
      "tag-push",
      "publish",
      "test-report-push",
      "jira-get",
      "jira-create",
      "jira-update",
      "jira-transition"
     ]
    },
    "subtask": {
     "$ref": "#/definitions/envelope_subtask"
    },
    "fields": {
     "type": "object"
    }
   }
  }
 },
 "envelope": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "verb",
   "status",
   "reason",
   "detail",
   "request_sha256",
   "sender",
   "utc"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"
   },
   "verb": {
    "enum": [
     "push",
     "pr-create",
     "pr-attach",
     "pr-comment",
     "pr-comments-read",
     "pr-approval-state",
     "pr-merge",
     "branch-delete",
     "ci-status",
     "ci-logs",
     "ci-rerun",
     "ci-status-main",
     "fetch",
     "tag-push",
     "publish",
     "test-report-push",
     "jira-get",
     "jira-create",
     "jira-update",
     "jira-transition"
    ]
   },
   "status": {
    "enum": [
     "DONE",
     "REJECTED"
    ]
   },
   "reason": {
    "oneOf": [
     {
      "enum": [
       "sender",
       "schema",
       "hash",
       "repo",
       "marker",
       "order",
       "policy",
       "stale-session",
       "gate-missing",
       "action-failed"
      ]
     },
     {
      "type": "null"
     }
    ]
   },
   "detail": {
    "oneOf": [
     {
      "type": "string",
      "pattern": "^[^\\n\\r]*$"
     },
     {
      "type": "null"
     }
    ]
   },
   "request_sha256": {
    "oneOf": [
     {
      "$ref": "#/definitions/sha256"
     },
     {
      "type": "null"
     }
    ]
   },
   "sender": {
    "type": "string",
    "minLength": 1
   },
   "utc": {
    "$ref": "#/definitions/utc"
   }
  },
  "$comment": "B6 envelope. On REJECTED it is the whole .out (reason set, detail non-null). On DONE reason and detail are null and the verb's result fields are added (see verbs.<verb>.result). request_sha256 is null when the reject precedes B3 step 4. No .out for reason sender.",
  "allOf": [
   {
    "if": {
     "properties": {
      "status": {
       "const": "DONE"
      }
     }
    },
    "then": {
     "properties": {
      "reason": {
       "type": "null"
      },
      "detail": {
       "type": "null"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "status": {
       "const": "REJECTED"
      }
     }
    },
    "then": {
     "properties": {
      "reason": {
       "enum": [
        "sender",
        "schema",
        "hash",
        "repo",
        "marker",
        "order",
        "policy",
        "stale-session",
        "gate-missing",
        "action-failed"
       ]
      },
      "detail": {
       "type": "string"
      }
     }
    }
   }
  ]
 },
 "verbs": {
  "push": {
   "conductor_only": false,
   "requester": "lead (delivery-run, ci-fix-loop) after GATE-PASS and PREPR: PASS",
   "result_reader": "lead",
   "markers": [
    "head",
    "gate-run"
   ],
   "inflight_target": "repo#branch@expect_head",
   "gate": null,
   "request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "repo",
     "branch",
     "expect_head"
    ],
    "properties": {
     "repo": {
      "$ref": "#/definitions/repo"
     },
     "branch": {
      "$ref": "#/definitions/branch"
     },
     "expect_head": {
      "$ref": "#/definitions/sha40"
     }
    }
   },
   "result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "verb",
     "status",
     "reason",
     "detail",
     "request_sha256",
     "sender",
     "utc",
     "head"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"
     },
     "verb": {
      "const": "push"
     },
     "status": {
      "const": "DONE"
     },
     "reason": {
      "type": "null"
     },
     "detail": {
      "type": "null"
     },
     "request_sha256": {
      "oneOf": [
       {
        "$ref": "#/definitions/sha256"
       },
       {
        "type": "null"
       }
      ]
     },
     "sender": {
      "type": "string",
      "minLength": 1
     },
     "utc": {
      "$ref": "#/definitions/utc"
     },
     "head": {
      "$ref": "#/definitions/sha40"
     }
    },
    "$comment": "DONE .out: envelope plus these fields; every field required, no other key"
   }
  },
  "pr-create": {
   "conductor_only": false,
   "requester": "delivery-run after PREPR: PASS",
   "result_reader": "lead (copies pr to substate.md)",
   "markers": [
    "head",
    "gate-run",
    "review-record"
   ],
   "inflight_target": "repo#branch@expect_head",
   "gate": null,
   "request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "repo",
     "branch",
     "base",
     "body_path",
     "labels",
     "record_path",
     "expect_head"
    ],
    "properties": {
     "repo": {
      "$ref": "#/definitions/repo"
     },
     "branch": {
      "$ref": "#/definitions/branch"
     },
     "base": {
      "$ref": "#/definitions/git_ref"
     },
     "body_path": {
      "$ref": "#/definitions/abs_path"
     },
     "labels": {
      "type": "array",
      "items": {
       "$ref": "#/definitions/label"
      }
     },
     "record_path": {
      "$ref": "#/definitions/abs_path"
     },
     "expect_head": {
      "$ref": "#/definitions/sha40"
     }
    }
   },
   "result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "verb",
     "status",
     "reason",
     "detail",
     "request_sha256",
     "sender",
     "utc",
     "pr",
     "head",
     "url"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"
     },
     "verb": {
      "const": "pr-create"
     },
     "status": {
      "const": "DONE"
     },
     "reason": {
      "type": "null"
     },
     "detail": {
      "type": "null"
     },
     "request_sha256": {
      "oneOf": [
       {
        "$ref": "#/definitions/sha256"
       },
       {
        "type": "null"
       }
      ]
     },
     "sender": {
      "type": "string",
      "minLength": 1
     },
     "utc": {
      "$ref": "#/definitions/utc"
     },
     "pr": {
      "$ref": "#/definitions/pr"
     },
     "head": {
      "$ref": "#/definitions/sha40"
     },
     "url": {
      "$ref": "#/definitions/https_url"
     }
    },
    "$comment": "DONE .out: envelope plus these fields; every field required, no other key"
   }
  },
  "pr-attach": {
   "conductor_only": false,
   "requester": "delivery-run right after pr-create",
   "result_reader": "delivery-run",
   "markers": [],
   "inflight_target": "repo#pr",
   "gate": null,
   "request": {
