     "verb",
     "status",
     "reason",
     "detail",
     "request_sha256",
     "sender",
     "utc",
     "pr",
     "attached"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"
     },
     "verb": {
