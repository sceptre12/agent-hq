{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "delivery-desk/references/schemas.json",
  "$comment": "Machine-readable copy of INTERFACES 1.10.0 part B (AM-6 B-9a, AM-7 VERDICT, AM-8 V7, AM-10 ci-status ci_run_id reconciled) (B1, B2, B2.1, B4, B6, B8, B9); part B is the authority. verbs.<verb>.request validates the .req 'fields' object; verbs.<verb>.result validates a DONE .out; envelope alone validates a REJECTED .out.",
  "interfaces_version": "1.10.0",
  "definitions": {
    "abs_path": {"type": "string", "pattern": "^/[^\\u0000-\\u001f\\u007f]+$", "$comment": "absolute path; the desk realpaths it under the root named in the B4 per-field rules"},
    "repo": {"type": "string", "pattern": "^/[^\\u0000-\\u001f\\u007f]+$", "$comment": "abs path; realpath under a registered clone (B3 step 6, else repo)"},
    "branch": {"type": "string", "$comment": "deliberately no pattern here: the branch regex ^[A-Z][A-Z0-9]+-[0-9]+(-[a-z0-9-]+)?$ is applied at B3 check 6 and fails as repo (part B2.1 repo row; B3 step 6), not schema at check 5. The regex cannot start with -, so a branch never reaches argv as a flag; the desk also passes it only as refs/heads/<branch> or after -- / --end-of-options"},
    "git_ref": {"type": "string", "pattern": "^[A-Za-z0-9._/][A-Za-z0-9._/-]*$", "$comment": "part B4 git ref charset with no leading - (no raw flag, ADR 0055 section 4; same rule as tools/delivery/desk-req-schema.sh ref); a leading - is schema at check 5"},
    "pr": {"type": "integer", "minimum": 0, "$comment": "part B4 int; minimum 0 matches desk-req-schema.sh int (>= 0); part B sets no other bound. Lexical rule (A.8 A.5 contract rule, PR10-R2; AM-5 numeric guards): an int is written as plain decimal digits, so -0 and exponent forms (1e3, 1E+3) are schema at check 5; JSON Schema cannot see the lexical form, so the desk applies it to the raw .req text"},
    "ci_run_id": {"type": "integer", "minimum": 0, "$comment": "part B4 int; minimum 0 matches desk-req-schema.sh int (>= 0); -0 and exponent forms are schema (see pr)"},
    "ci_run_id_or_null": {"oneOf": [{"$ref": "#/definitions/ci_run_id"}, {"type": "null"}], "$comment": "AM-10 ci-status reply item only: null means this check has no CI run the desk can address (its link carries no /actions/runs/<id>: an external status context or a still-pending check); ci-logs and ci-rerun requests take ci_run_id, never null (a null there is schema; a ci-logs naming a check with null is policy)"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fields_subtask": {"type": "string", "pattern": "^(st[0-9]+|pm)$"},
    "envelope_subtask": {"type": "string", "pattern": "^(st[0-9]+|pm|run)$"},
    "label": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "$comment": "part B4 and desk-req-schema.sh labels; a label is only ever passed as the attached value --label=<label>, never as a separate argv word, so a leading - cannot act as a flag"},
    "job": {"type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f]{1,200}$"},
    "tag": {"type": "string", "pattern": "^[A-Za-z0-9._/][A-Za-z0-9._/-]*$", "$comment": "part B4 tag charset with no leading - (no raw flag; same rule as desk-req-schema.sh tag); a leading - is schema at check 5"},
    "package": {"type": "string", "pattern": "^(@[a-z0-9-]+/)?[a-z0-9._][a-z0-9._-]*$", "$comment": "part B4 npm name with no leading - in the scope-less part (no raw flag, ADR 0055 section 4; same first-character rule as desk-req-schema.sh package); a leading - is schema at check 5 (leading-- guard on package is a contract rule, B9 26, PR10-R2)"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$", "$comment": "SemVer 2.0; a numeric prerelease id has no leading zero (1.0.0-01 is schema; B9 26)"},
    "step_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "jira_key": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"},
    "method": {"enum": ["squash", "merge", "rebase"], "$comment": "must also equal the profile merge_method (B4); else repo at check 6 (AM-8 V7)"},
    "transition_to": {"enum": ["Backlog", "In Progress", "In Review", "Blocked", "Verified", "Done", "archive"], "$comment": "D3 canonical status or archive (profile jira.archive_status)"},
    "str_or_strs": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
    "jira_fields_write": {"type": "object", "additionalProperties": false, "properties": {"summary": {"$ref": "#/definitions/str_or_strs"}, "description": {"$ref": "#/definitions/str_or_strs"}, "issuetype": {"$ref": "#/definitions/str_or_strs"}, "parent": {"$ref": "#/definitions/str_or_strs"}, "labels": {"$ref": "#/definitions/str_or_strs"}, "priority": {"$ref": "#/definitions/str_or_strs"}, "components": {"$ref": "#/definitions/str_or_strs"}}, "$comment": "closed Jira write allowlist (B4, card 14, M29)"},
    "jira_readable_name": {"enum": ["summary", "description", "issuetype", "parent", "labels", "priority", "components", "status"]},
    "jira_fields_read": {"type": "object", "additionalProperties": false, "properties": {"summary": {"$ref": "#/definitions/str_or_strs"}, "description": {"$ref": "#/definitions/str_or_strs"}, "issuetype": {"$ref": "#/definitions/str_or_strs"}, "parent": {"$ref": "#/definitions/str_or_strs"}, "labels": {"$ref": "#/definitions/str_or_strs"}, "priority": {"$ref": "#/definitions/str_or_strs"}, "components": {"$ref": "#/definitions/str_or_strs"}, "status": {"$ref": "#/definitions/str_or_strs"}}},
    "https_url": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "ci_state": {"enum": ["success", "failure", "pending", "skipped", "cancelled"]},
    "request_file": {"$comment": "RUN_HOME/desk/<id>.req as written by desk-req.sh (B3 sender step); id, verb, subtask are cross-checked against the DESK line on the hashed copy (B3 step 5, else schema)", "type": "object", "additionalProperties": false, "required": ["id", "verb", "subtask", "fields"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"}, "verb": {"enum": ["push", "pr-create", "pr-attach", "pr-comment", "pr-comments-read", "pr-approval-state", "pr-merge", "branch-delete", "ci-status", "ci-logs", "ci-rerun", "ci-status-main", "fetch", "tag-push", "publish", "test-report-push", "jira-get", "jira-create", "jira-update", "jira-transition"]}, "subtask": {"$ref": "#/definitions/envelope_subtask"}, "fields": {"type": "object"}}}
  },
  "envelope": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "verb", "status", "reason", "detail", "request_sha256", "sender", "utc"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"},
      "verb": {"$comment": "The verb as it appeared on the DESK line (DESK regex verb group); part B6 (part-b-desk.md:116) sets no enum, so a REJECTED .out for a non-B4 verb (approve, trigger-prod, pipeline-edit: schema) or a hash reject still validates. A DONE .out is held to the B4 verb by verbs.<verb>.result (verb const).", "type": "string", "pattern": "^[a-z-]+$"},
      "status": {"enum": ["DONE", "REJECTED"]},
      "reason": {"oneOf": [{"enum": ["sender", "schema", "hash", "repo", "marker", "order", "policy", "stale-session", "gate-missing", "action-failed"]}, {"type": "null"}]},
      "detail": {"oneOf": [{"type": "string", "pattern": "^[^\\n\\r]*$"}, {"type": "null"}]},
      "request_sha256": {"oneOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
      "sender": {"type": "string", "minLength": 1},
      "utc": {"$ref": "#/definitions/utc"}
    },
    "$comment": "B6 envelope. On REJECTED it is the whole .out (reason set, detail non-null). On DONE reason and detail are null and the verb's result fields are added (see verbs.<verb>.result). request_sha256 is null when the reject precedes B3 step 4. No .out for reason sender.",
    "allOf": [{"if": {"properties": {"status": {"const": "DONE"}}}, "then": {"properties": {"reason": {"type": "null"}, "detail": {"type": "null"}}}}, {"if": {"properties": {"status": {"const": "REJECTED"}}}, "then": {"properties": {"reason": {"enum": ["sender", "schema", "hash", "repo", "marker", "order", "policy", "stale-session", "gate-missing", "action-failed"]}, "detail": {"type": "string"}}}}]
  },
  "verbs": {
    "push": {
      "conductor_only": false,
      "requester": "lead (delivery-run, ci-fix-loop): first push of a PR after GATE-PASS and PREPR: PASS for expect_head; a later push to the same PR after GATE-PASS plus ci/<pr>.md naming the head or PREPR: PASS (AM-4 24-Q2)",
      "result_reader": "lead",
      "markers": ["head", "gate-run", "first-or-later-push"],
      "inflight_target": "repo#branch@expect_head",
      "gate": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "branch", "expect_head"],
        "properties": {
          "repo": {"$ref": "#/definitions/repo"},
          "branch": {"$ref": "#/definitions/branch"},
          "expect_head": {"$ref": "#/definitions/sha40"}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verb", "status", "reason", "detail", "request_sha256", "sender", "utc", "head"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"},
          "verb": {"const": "push"},
          "status": {"const": "DONE"},
          "reason": {"type": "null"},
          "detail": {"type": "null"},
          "request_sha256": {"oneOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
          "sender": {"type": "string", "minLength": 1},
          "utc": {"$ref": "#/definitions/utc"},
          "head": {"$ref": "#/definitions/sha40"}
        },
        "$comment": "DONE .out: envelope plus these fields; every field required, no other key"
      }
    },
    "pr-create": {
      "conductor_only": false,
      "requester": "delivery-run after PREPR: PASS",
      "result_reader": "lead (copies pr to substate.md)",
      "markers": ["head", "gate-run", "review-record"],
      "inflight_target": "repo#branch@expect_head",
      "gate": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "branch", "base", "body_path", "labels", "record_path", "expect_head"],
        "properties": {
          "repo": {"$ref": "#/definitions/repo"},
          "branch": {"$ref": "#/definitions/branch"},
          "base": {"$ref": "#/definitions/git_ref"},
          "body_path": {"$ref": "#/definitions/abs_path"},
          "labels": {"type": "array", "items": {"$ref": "#/definitions/label"}},
          "record_path": {"$ref": "#/definitions/abs_path"},
          "expect_head": {"$ref": "#/definitions/sha40"}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verb", "status", "reason", "detail", "request_sha256", "sender", "utc", "pr", "head", "url"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"},
          "verb": {"const": "pr-create"},
          "status": {"const": "DONE"},
          "reason": {"type": "null"},
          "detail": {"type": "null"},
          "request_sha256": {"oneOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
          "sender": {"type": "string", "minLength": 1},
          "utc": {"$ref": "#/definitions/utc"},
          "pr": {"$ref": "#/definitions/pr"},
          "head": {"$ref": "#/definitions/sha40"},
          "url": {"$ref": "#/definitions/https_url"}
        },
        "$comment": "DONE .out: envelope plus these fields; every field required, no other key"
      }
    },
    "pr-attach": {
      "conductor_only": false,
      "requester": "delivery-run right after pr-create",
      "result_reader": "delivery-run",
      "markers": [],
      "inflight_target": "repo#pr",
      "gate": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "pr", "paths"],
        "properties": {
          "repo": {"$ref": "#/definitions/repo"},
          "pr": {"$ref": "#/definitions/pr"},
          "paths": {"type": "array", "items": {"$ref": "#/definitions/abs_path"}}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verb", "status", "reason", "detail", "request_sha256", "sender", "utc", "pr", "attached"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"},
          "verb": {"const": "pr-attach"},
          "status": {"const": "DONE"},
          "reason": {"type": "null"},
          "detail": {"type": "null"},
          "request_sha256": {"oneOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
          "sender": {"type": "string", "minLength": 1},
          "utc": {"$ref": "#/definitions/utc"},
          "pr": {"$ref": "#/definitions/pr"},
          "attached": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "url"], "properties": {"path": {"$ref": "#/definitions/abs_path"}, "url": {"$ref": "#/definitions/https_url"}}}}
        },
        "$comment": "DONE .out: envelope plus these fields; every field required, no other key"
      }
    },
    "pr-comment": {
      "conductor_only": false,
      "requester": "delivery-run, ci-fix-loop",
      "result_reader": "same",
      "markers": [],
      "inflight_target": null,
      "gate": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "pr", "body_path"],
        "properties": {
          "repo": {"$ref": "#/definitions/repo"},
          "pr": {"$ref": "#/definitions/pr"},
          "body_path": {"$ref": "#/definitions/abs_path"}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verb", "status", "reason", "detail", "request_sha256", "sender", "utc", "pr", "comment_url"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"},
          "verb": {"const": "pr-comment"},
          "status": {"const": "DONE"},
          "reason": {"type": "null"},
          "detail": {"type": "null"},
          "request_sha256": {"oneOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
          "sender": {"type": "string", "minLength": 1},
          "utc": {"$ref": "#/definitions/utc"},
          "pr": {"$ref": "#/definitions/pr"},
          "comment_url": {"$ref": "#/definitions/https_url"}
        },
        "$comment": "DONE .out: envelope plus these fields; every field required, no other key"
      }
    },
    "pr-comments-read": {
      "conductor_only": false,
      "requester": "ci-fix-loop",
      "result_reader": "ci-fix-loop",
      "markers": [],
      "inflight_target": null,
      "gate": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "pr"],
        "properties": {
          "repo": {"$ref": "#/definitions/repo"},
          "pr": {"$ref": "#/definitions/pr"}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verb", "status", "reason", "detail", "request_sha256", "sender", "utc", "comments_path"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"},
          "verb": {"const": "pr-comments-read"},
          "status": {"const": "DONE"},
          "reason": {"type": "null"},
          "detail": {"type": "null"},
          "request_sha256": {"oneOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
          "sender": {"type": "string", "minLength": 1},
          "utc": {"$ref": "#/definitions/utc"},
          "comments_path": {"$ref": "#/definitions/abs_path"}
        },
        "$comment": "DONE .out: envelope plus these fields; every field required, no other key"
      }
    },
    "pr-approval-state": {
      "conductor_only": false,
      "requester": "conductor",
      "result_reader": "conductor",
      "markers": [],
      "inflight_target": null,
      "gate": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "pr"],
        "properties": {
          "repo": {"$ref": "#/definitions/repo"},
          "pr": {"$ref": "#/definitions/pr"}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verb", "status", "reason", "detail", "request_sha256", "sender", "utc", "reviewDecision", "headRefOid", "author", "approving_reviews", "h_pr"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"},
          "verb": {"const": "pr-approval-state"},
          "status": {"const": "DONE"},
          "reason": {"type": "null"},
          "detail": {"type": "null"},
          "request_sha256": {"oneOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
          "sender": {"type": "string", "minLength": 1},
          "utc": {"$ref": "#/definitions/utc"},
          "reviewDecision": {"enum": ["APPROVED", "CHANGES_REQUESTED", "REVIEW_REQUIRED", ""]},
          "headRefOid": {"$ref": "#/definitions/sha40"},
          "author": {"type": "string"},
          "approving_reviews": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["login", "state", "commit_id"], "properties": {"login": {"type": "string"}, "state": {"enum": ["APPROVED", "CHANGES_REQUESTED", "COMMENTED", "DISMISSED", "PENDING"]}, "commit_id": {"$ref": "#/definitions/sha40"}}}},
          "h_pr": {"type": "boolean"}
        },
        "$comment": "DONE .out: envelope plus these fields; every field required, no other key"
      }
    },
    "pr-merge": {
      "conductor_only": true,
      "requester": "conductor only",
      "result_reader": "conductor (writes merge-<sha>.md)",
      "markers": ["head", "gate-run", "review-record", "h-pr", "ci", "order", "merge_reach", "merge-target"],
      "inflight_target": "repo#pr",
      "gate": "merge_reach row (gate-missing)",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "pr", "subtask", "method", "expect_head", "predecessors", "record_path"],
        "properties": {
          "repo": {"$ref": "#/definitions/repo"},
          "pr": {"$ref": "#/definitions/pr"},
          "subtask": {"$ref": "#/definitions/fields_subtask"},
          "method": {"$ref": "#/definitions/method"},
          "expect_head": {"$ref": "#/definitions/sha40"},
          "predecessors": {"type": "array", "items": {"$ref": "#/definitions/pr"}},
          "record_path": {"$ref": "#/definitions/abs_path"}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verb", "status", "reason", "detail", "request_sha256", "sender", "utc", "merge_sha", "merge_reach"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"},
          "verb": {"const": "pr-merge"},
          "status": {"const": "DONE"},
          "reason": {"type": "null"},
          "detail": {"type": "null"},
          "request_sha256": {"oneOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
          "sender": {"type": "string", "minLength": 1},
          "utc": {"$ref": "#/definitions/utc"},
          "merge_sha": {"$ref": "#/definitions/sha40"},
          "merge_reach": {"type": "string", "$comment": "the profile row verbatim"}
        },
        "$comment": "DONE .out: envelope plus these fields; every field required, no other key"
      }
    },
    "branch-delete": {
      "conductor_only": false,
      "requester": "delivery-cleanup (host lead or conductor sends)",
      "result_reader": "delivery-cleanup",
      "markers": ["content-merged"],
      "inflight_target": "repo#branch",
      "gate": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "branch", "merged_into", "merge_sha"],
        "properties": {
          "repo": {"$ref": "#/definitions/repo"},
          "branch": {"$ref": "#/definitions/branch"},
          "merged_into": {"$ref": "#/definitions/git_ref"},
          "merge_sha": {"$ref": "#/definitions/sha40"}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verb", "status", "reason", "detail", "request_sha256", "sender", "utc", "deleted", "merged_check"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+$"},
          "verb": {"const": "branch-delete"},
          "status": {"const": "DONE"},
          "reason": {"type": "null"},
          "detail": {"type": "null"},
          "request_sha256": {"oneOf": [{"$ref": "#/definitions/sha256"}, {"type": "null"}]},
          "sender": {"type": "string", "minLength": 1},
          "utc": {"$ref": "#/definitions/utc"},
          "deleted": {"const": true},
          "merged_check": {"enum": ["ancestor", "patch-id", "squash"]}
        },
        "$comment": "DONE .out: envelope plus these fields; every field required, no other key"
      }
    },
    "ci-status": {
      "conductor_only": false,
      "requester": "ci-fix-loop",
      "result_reader": "ci-fix-loop",
      "markers": [],
      "inflight_target": null,
      "gate": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "pr"],
        "properties": {
          "repo": {"$ref": "#/definitions/repo"},
          "pr": {"$ref": "#/definitions/pr"}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
