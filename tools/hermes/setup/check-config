#!/usr/bin/python3 -I
# check-config: standalone pre-flight verifier for a Hermes config.yaml (no Hermes code, no network, no token, stdlib only).
# Run as:  /usr/bin/python3 -I tools/hermes/setup/check-config [--home <HERMES_HOME>] [--tsv <path>] [--yaml <path>]
# (the file needs no exec bit). Defaults: --home from $HERMES_HOME; yaml = <home>/config.yaml; tsv = required-config.tsv
# beside this script. Prints one PASS/FAIL line per requirement row, then the no-always check, then the hook-file check.
# Last line: `CHECK-CONFIG: PASS n=<checks>` (exit 0) or `CHECK-CONFIG: FAIL failed=<k> of <checks>` (exit 1), where
# <checks> counts every PASS/FAIL line (SKIP lines are not counted). Exit 2 = usage or parse error, 3 = yaml/tsv unreadable.
# Only keys named in the TSV are printed; other keys and map contents are never echoed (map values print as `{<n> key(s)}`).
#
# YAML SUBSET (anything else fails closed: `UNPARSEABLE line <n>: <reason>`, exit 2):
#   - block mappings nested by exactly 2 spaces; `key: value` or `key:` (then a nested block, or null when none follows);
#   - scalars: bare, "double-quoted" (\\ \" \n \t escapes), 'single-quoted' ('' escape); optional trailing ` # comment`
#     (a `#` inside quotes, or not preceded by whitespace, is not a comment);
#   - one-line flow lists `[a, "b c"]` of scalars; the flow map `{}` only;
#   - block lists of scalars (`- a`) and of mappings (`- command: x` then keys indented 2 more than the dash).
#   Refused: tab indentation, odd indents, duplicate keys at one level, anchors/aliases/tags (& * !), block scalars (| >),
#   multi-line or nested flow collections, non-empty flow maps, `---`/`...` documents, `key: a: b`.
# Scalar typing (for comparisons): a bare true/false is a bool, a bare integer an int, a bare empty/~/null a null, all else a
# string; a quoted scalar is always a string. A scalar is the tuple (kind, text); two scalars are equal when kind and
# text match exactly (case-sensitive).
import os, re, stat, sys

USAGE = """usage: /usr/bin/python3 -I tools/hermes/setup/check-config [--home <HERMES_HOME>] [--tsv <path>] [--yaml <path>]
  --home  Hermes home (default: $HERMES_HOME); config.yaml is read from it, and the hook file is checked
  --yaml  config file to check (default: <home>/config.yaml)
  --tsv   requirements file (default: required-config.tsv beside this script)
Reads files only; never runs Hermes, never touches the network. Exit 0 pass, 1 fail, 2 usage/parse error, 3 unreadable."""
OPS = ("eq", "set-eq", "empty-map", "has-hook", "unset-or-eq")
HOOK_MATCHER = "read_file|write_file|patch|search_files"
KEY_RE = re.compile(r'^([A-Za-z_][A-Za-z0-9_.\-]*|"[^"\\]*"|\'[^\']*\')[ ]*:(?:[ ]+(.*))?$')
ABSENT = object()

class ParseError(Exception):
    def __init__(self, n, why):
        Exception.__init__(self, why)
        self.n, self.why = n, why

def sshow(x):
    return '"%s"' % x[1] if x[0] == "str" and (x[1] == "" or " " in x[1]) else x[1]

def strip_comment(s, n):
    q, i = None, 0
    while i < len(s):
        c = s[i]
        if q == '"':
            if c == "\\": i += 1
            elif c == '"': q = None
        elif q == "'":
            if c == "'": q = None
        elif c in "\"'" and (i == 0 or s[i - 1] in " [,:"): q = c
        elif c == "#" and (i == 0 or s[i - 1] in " \t"): return s[:i].rstrip()
        i += 1
    if q: raise ParseError(n, "unterminated quote")
    return s.rstrip()

def unquote(s, n):
    if s[0] == '"':
        if len(s) < 2 or s[-1] != '"': raise ParseError(n, "bad double-quoted scalar")
        out, i, body = [], 0, s[1:-1]
        while i < len(body):
            c = body[i]
            if c == '"': raise ParseError(n, "text after closing quote")
            if c == "\\":
                i += 1
                e = body[i] if i < len(body) else ""
                if e not in '\\"nt': raise ParseError(n, "unsupported escape")
                c = {"n": "\n", "t": "\t"}.get(e, e)
            out.append(c)
            i += 1
        return "".join(out)
    if len(s) < 2 or s[-1] != "'" or "'" in s[1:-1].replace("''", ""): raise ParseError(n, "bad single-quoted scalar")
    return s[1:-1].replace("''", "'")

def scalar(s, n):
    s = s.strip()
    if s[:1] in ('"', "'"): return ("str", unquote(s, n))
    if s[:1] in ("&", "*", "!", "|", ">", "@", "`", "%"): raise ParseError(n, "unsupported construct %r" % s[:1])
    if s[:1] in ("[", "]", "{", "}") or s.startswith("- ") or s == "-": raise ParseError(n, "nested collection")
    if re.search(r":( |$)", s): raise ParseError(n, "mapping inside a scalar")
    if s in ("", "~", "null"): return ("null", "")
    if s in ("true", "false"): return ("bool", s)
    if re.match(r"^-?[0-9]+$", s): return ("int", s)
    return ("str", s)

def split_flow(body, n):
    items, cur, q, i = [], [], None, 0
    while i < len(body):
        c = body[i]
        if q:
            cur.append(c)
            if q == '"' and c == "\\":
                i += 1
                cur.append(body[i] if i < len(body) else "")
            elif c == q: q = None
        elif c in "\"'":
            q = c
            cur.append(c)
        elif c == ",":
            items.append("".join(cur))
            cur = []
        elif c in "[]{}": raise ParseError(n, "nested flow collection")
        else: cur.append(c)
        i += 1
    items.append("".join(cur))
    if len(items) == 1 and not items[0].strip(): return []
    if any(not x.strip() for x in items): raise ParseError(n, "empty flow list item")
    return [scalar(x, n) for x in items]

def value(s, n):
    s = s.strip()
    if s.startswith("{"):
        if re.match(r"^\{\s*\}$", s): return {}
        raise ParseError(n, "non-empty or multi-line flow map")
    if s.startswith("["):
        if not s.endswith("]"): raise ParseError(n, "multi-line flow list")
        return split_flow(s[1:-1], n)
    return scalar(s, n)

def tokenize(text):
    out = []
    for n, raw in enumerate(text.split("\n"), 1):
        body = raw.rstrip("\r")
        lead = body[:len(body) - len(body.lstrip(" \t"))]
        if "\t" in lead and body.strip(): raise ParseError(n, "tab in indentation")
        s = strip_comment(body.strip(), n)
        if not s: continue
        if s in ("---", "...") or s.startswith("%"): raise ParseError(n, "document markers/directives unsupported")
        ind = len(lead)
        if ind % 2: raise ParseError(n, "indent is not a multiple of 2 spaces")
        out.append([n, ind, s])
    return out

def parse_block(L, i, ind):
    if L[i][2] == "-" or L[i][2].startswith("- "): return parse_list(L, i, ind)
    return parse_map(L, i, ind)

def parse_map(L, i, ind):
    m = {}
    while i < len(L) and L[i][1] == ind:
        n, _, s = L[i]
        if s == "-" or s.startswith("- "): raise ParseError(n, "list item inside a mapping")
        k = KEY_RE.match(s)
        if not k: raise ParseError(n, "not a key: value line")
        key = k.group(1)
        if key[0] in "\"'": key = unquote(key, n)
        if key in m: raise ParseError(n, "duplicate key %r" % key)
        rest = (k.group(2) or "").strip()
        i += 1
        if rest:
            m[key] = value(rest, n)
            if i < len(L) and L[i][1] > ind: raise ParseError(L[i][0], "unexpected indent after a scalar")
        elif i < len(L) and L[i][1] > ind:
            if L[i][1] != ind + 2: raise ParseError(L[i][0], "nested block not indented by exactly 2")
            m[key], i = parse_block(L, i, ind + 2)
        else: m[key] = ("null", "")
    return m, i

def parse_list(L, i, ind):
    out = []
    while i < len(L) and L[i][1] == ind:
        n, _, s = L[i]
        if not (s == "-" or s.startswith("- ")): raise ParseError(n, "mapping key inside a list")
        rest = s[1:].strip()
        if not rest: raise ParseError(n, "empty list item")
        if KEY_RE.match(rest):
            L[i] = [n, ind + 2, rest]          # `- k: v` -> mapping item whose keys sit at ind+2
            item, i = parse_map(L, i, ind + 2)
            out.append(item)
            continue
        out.append(value(rest, n))
        i += 1
        if i < len(L) and L[i][1] > ind: raise ParseError(L[i][0], "unexpected indent after a list item")
    return out, i

def parse_yaml(text):
    L = tokenize(text)
    if not L: return {}
    if L[0][1] != 0: raise ParseError(L[0][0], "document does not start at column 0")
    doc, i = parse_map(L, 0, 0)
    if i < len(L): raise ParseError(L[i][0], "unexpected indent")
    return doc

def lookup(doc, dotted):
    d = doc
    for k in dotted.split("."):
        if not isinstance(d, dict) or k not in d: return ABSENT
        d = d[k]
    return d

def show(v):
    if v is ABSENT: return "absent"
    if isinstance(v, dict): return "{%d key(s)}" % len(v)
    if isinstance(v, list): return "[" + ", ".join(sshow(x) if isinstance(x, tuple) else "<map>" for x in v) + "]"
    return sshow(v)[:80]

def hook_ok(e, cmd):
    if not isinstance(e, dict): return False
    fc = [e[k] for k in ("fail_closed", "failClosed") if k in e]
    return (e.get("command") == ("str", cmd) and e.get("matcher") == ("str", HOOK_MATCHER)
            and e.get("timeout") == ("int", "10") and bool(fc) and all(x == ("bool", "true") for x in fc))

def check(doc, key, op, want, raw):
    got = lookup(doc, key)
    if op == "eq": return got == want, show(got)
    if op == "unset-or-eq": return got is ABSENT or got == want, show(got)
    if op == "empty-map": return got == {}, show(got)
    if op == "set-eq":
        if not isinstance(got, list) or not all(isinstance(x, tuple) for x in got):
            return False, show(got) if not isinstance(got, list) else "a list with non-scalar items"
        g, w = set(got), set(want)
        miss, extra = sorted(sshow(x) for x in w - g), sorted(sshow(x) for x in g - w)
        return not miss and not extra, "%d item(s), missing [%s], extra [%s]" % (len(got), ", ".join(miss), ", ".join(extra))
    cmd = raw.replace("__HOME__", os.environ.get("HOME", ""))
    if not isinstance(got, list): return False, show(got) if not isinstance(got, dict) else "a mapping, not a list"
    return any(hook_ok(e, cmd) for e in got), "no matching entry among %d" % len(got)

def read_tsv(path):
    rows = []
    with open(path, encoding="utf-8") as f:
        text = f.read()
    for n, ln in enumerate(text.split("\n"), 1):
        if not ln.strip() or ln.lstrip().startswith("#"): continue
        p = ln.split("\t")
        if len(p) != 3 or p[1] not in OPS or not p[0]:
            raise ParseError(n, "TSV row needs <key>\\t<op>\\t<value> with op in " + "|".join(OPS))
        try: want = value(p[2], n) if p[1] not in ("has-hook", "empty-map") else None
        except ParseError as e: raise ParseError(n, "TSV value: " + e.why)
        if p[1] == "set-eq" and not isinstance(want, list): raise ParseError(n, "TSV set-eq value must be a flow list")
        rows.append((p[0], p[1], want, p[2]))
    if not rows: raise ParseError(0, "TSV has no rows")
    return rows

def main(argv):
    opts, i = {}, 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(USAGE)
            return 0
        if a in ("--home", "--tsv", "--yaml") and i + 1 < len(argv) and a not in opts:
            opts[a] = argv[i + 1]
            i += 2
            continue
        print("check-config: bad argument: %s\n%s" % (a, USAGE), file=sys.stderr)
        return 2
    home = opts.get("--home") or os.environ.get("HERMES_HOME", "")
    yaml_p = opts.get("--yaml") or (home and os.path.join(home, "config.yaml"))
    if not yaml_p:
        print("check-config: no --home, --yaml or $HERMES_HOME\n" + USAGE, file=sys.stderr)
        return 2
    tsv_p = opts.get("--tsv") or os.path.join(os.path.dirname(os.path.abspath(__file__)), "required-config.tsv")
    try: rows = read_tsv(tsv_p)
    except (OSError, UnicodeDecodeError) as e:
        print("UNREADABLE tsv %s: %s" % (tsv_p, type(e).__name__))
        return 3
    except ParseError as e:
        print("BAD-TSV line %d: %s" % (e.n, e.why))
        return 2
    try:
        with open(yaml_p, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as e:
        print("UNREADABLE yaml %s: %s" % (yaml_p, type(e).__name__))
        return 3
    try: doc = parse_yaml(text)
    except ParseError as e:
        print("UNPARSEABLE line %d: %s" % (e.n, e.why))
        return 2
    total = failed = 0

    def report(ok, name, why):
        nonlocal total, failed
        total += 1
        if ok: print("PASS " + name)
        else:
            failed += 1
            print("FAIL %s: %s" % (name, why))
    for key, op, want, raw in rows:
        ok, got = check(doc, key, op, want, raw)
        report(ok, key, "want %s %s, got %s" % (op, raw, got))
    n_always = 0
    for n, ln in enumerate(text.split("\n"), 1):
        if "always" in strip_comment(ln, n): n_always += 1
    report(n_always == 0, "no-always", "%d line(s)" % n_always)
    hooks = [r for r in rows if r[1] == "has-hook"]
    hp = hooks[0][3].replace("__HOME__", os.environ.get("HOME", "")) if hooks else ""
    if not opts.get("--home"): print("SKIP hook-file (no --home)")
    elif not hp or not os.path.lexists(hp): print("SKIP hook-file (not present)")
    else:
        st = os.lstat(hp)
        report(stat.S_ISREG(st.st_mode), "hook-file", "not a regular file")
        if stat.S_ISREG(st.st_mode):
            report(stat.S_IMODE(st.st_mode) == 0o555, "hook-mode", "mode %o, want 555" % stat.S_IMODE(st.st_mode))
    print("CHECK-CONFIG: FAIL failed=%d of %d" % (failed, total) if failed else "CHECK-CONFIG: PASS n=%d" % total)
    return 1 if failed else 0

if __name__ == "__main__": sys.exit(main(sys.argv[1:]))
