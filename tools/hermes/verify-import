#!/usr/bin/env bash
# tools/hermes/verify-import — thin shim; the logic is verify_import.py (run isolated, no bytecode: python -B -I).
# The script directory is resolved through symlinks (as in import-learnings), so a symlink to this shim works.
exec python3 -B -I "$(python3 -B -I -c 'import os,sys;print(os.path.dirname(os.path.realpath(sys.argv[1])))' "${BASH_SOURCE[0]}")/verify_import.py" "$@"
