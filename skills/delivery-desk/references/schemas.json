 "reason_codes": {
  "sender": {
   "class": "terminal",
   "b3_step": 1,
   "trigger": "transport sender not in the desk-held registry for the run; a conductor-only verb whose sender is not the registered conductor or whose <id> subtask is not run; any <id> with <subtask> run whose transport sender is not the registry's run id. No .out is written."
  },
  "schema": {
   "class": "terminal",
   "b3_step": 5,
   "trigger": "the copy fails the closed per-verb schema: unknown verb, unknown or missing field, raw flag, force, string where an array is required, id/verb/subtask in the JSON differing from the line (including a relayed claude -p request whose subtask does not match the id); also a DESK path not equal to RUN_HOME/desk/<id>.req"
  },
  "hash": {
   "class": "terminal",
   "b3_step": 4,
   "trigger": "the copy's sha256 differs from sha256=<hex>"
  },
  "repo": {
   "class": "terminal",
   "b3_step": 6,
   "trigger": "repo not under a registered clone (resolves to no profile); branch fails <JIRA-KEY>(-[a-z0-9-]+)?; body_path, payload_path, record_path or an attachment path outside its allowed root"
  },
  "marker": {
   "class": "curable",
   "b3_step": 8,
   "trigger": "a re-derived marker fails: head sha, CODE-GATE-REVIEW/Verified-By, H-pr approval, CI not green at pr-merge, GATE-PASS record missing for a push or pr-create, branch-delete content not merged into merged_into; also push-spacing and pipeline-bound (detail)"
  },
  "order": {
   "class": "curable",
   "b3_step": 8,
   "trigger": "a pr-merge predecessor is not merged"
  },
  "policy": {
   "class": "terminal",
   "b3_step": 6,
   "trigger": "a request the desk never grants (approve, trigger-prod, pipeline edit, ci-rerun on a non-flake class, force); a tag-push the repo profile does not allow (no release_tags entry, used \"no\", tag not matching pattern, malformed entry); a redaction hit in a body, payload, attachment or string field"
  },
  "stale-session": {
   "class": "curable",
   "b3_step": 7,
   "trigger": "the GitHub or Atlassian session is not fresh"
  },
  "gate-missing": {
   "class": "curable",
   "b3_step": 8,
   "trigger": "H1.ok absent before jira-create; H-prod.<step_id>.ok absent before publish, or before a tag-push under release_tags.approval human; merge_reach row absent before pr-merge"
  },
  "action-failed": {
   "class": "curable",
   "b3_step": 9,
   "trigger": "a valid request whose action then fails (non-fast-forward, branch protection, remote or gh error); .inflight stays"
  }
 },
 "regexes": {
  "$comment": "POSIX ERE (INTERFACES Regex dialect); copied from part B. These lines are not verbs (RESOLVED Q2).",
  "id": "^([a-z0-9-]+)-(st[0-9]+|pm|run)-([0-9]{8}T[0-9]{6}Z)-([0-9]+)$",
  "run_subtask_prefix": "^[a-z][a-z0-9]*-[0-9]+-[0-9]{8}(-[0-9]+)?-(st[0-9]+|pm|run)$",
  "DESK": "^DESK +([a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+) \\| ([a-z-]+) \\| (/[^ ]+) \\| sha256=([0-9a-f]{64})$",
  "DONE": "^DONE +([a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+) \\| ([a-z-]+) \\| result=(/[^ ]+) \\| ([^|[:cntrl:]]+)$",
  "REJECTED": "^REJECTED +([a-z0-9-]+-(st[0-9]+|pm|run)-[0-9]{8}T[0-9]{6}Z-[0-9]+) \\| (sender|schema|hash|repo|marker|order|policy|stale-session|gate-missing|action-failed)$",
  "REGISTER-SENDER": "^REGISTER-SENDER ([a-z0-9-]+) \\| (st[0-9]+|pm|run) \\| ([^ ]+)$",
  "REGISTERED": "^REGISTERED ([a-z0-9-]+) \\| (st[0-9]+|pm|run) \\| (ok|refused)$",
  "GATE": "^GATE ([a-z0-9-]+) (H0|H1|H-e2e\\.(st[0-9]+|pm)|H-pr|H-prod\\.[a-z0-9-]+) (ok|changes|reject)( .+)?$",
  "ANSWER": "^ANSWER ([a-z0-9-]+) (st[0-9]+|pm) ([ui][0-9]+) (.+)$",
  "REBIND": "^REBIND ([a-z0-9-]+) ([^ ]+)$",
  "desk_address": "^desk$",
  "conductor_only_verbs": "^(pr-merge|publish|tag-push|test-report-push)$",
  "gate_verdicts": {
   "H0": [
    "ok"
   ],
   "H1": [
    "ok",
    "changes",
    "reject"
   ],
   "H-e2e.<subtask>": [
    "ok"
   ],
   "H-prod.<step_id>": [
    "ok"
   ],
   "H-pr": []
  }
 }
}
