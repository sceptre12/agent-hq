{
  "_tier": "executor",
  "_source": "architecture/permission-tiers-02.md §1 (ratified R-3 2026-10-14)",
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(npm add *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(bun add *)",
      "Bash(bun install *)",
      "Bash(npx *)",
      "Bash(pnpm dlx *)",
      "Bash(bunx *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(uvx *)",
      "Bash(uv tool install *)",
      "Bash(brew install *)",
      "Bash(brew tap *)",
      "Bash(cargo install *)",
      "Bash(gem install *)",
      "Bash(pod install *)",
      "Bash(corepack *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * push * --force*)",
      "Bash(claude plugin install *)",
      "Bash(claude plugin i *)",
      "Bash(claude plugin update *)",
      "Bash(claude plugin marketplace *)",
      "Bash(claude plugin init *)",
      "Bash(claude plugin new *)",
      "Bash(claude plugins *)",
      "Bash(claude mcp add *)",
      "Bash(claude mcp add-json *)",
      "Bash(claude mcp add-from-claude-desktop *)",
      "Edit(//$HOME/projects/agent-hq/config/**)",
      "Write(//$HOME/projects/agent-hq/config/**)",
      "Edit(//$HOME/projects/agent-hq-worktrees/*/config/**)",
      "Write(//$HOME/projects/agent-hq-worktrees/*/config/**)",
      "Edit(//$HOME/claude-profiles/*/config/settings.json)",
      "Write(//$HOME/claude-profiles/*/config/settings.json)",
      "Edit(//$HOME/.zshrc)",
      "Write(//$HOME/.zshrc)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Edit(//$HOME/claude-profiles/*/profile.env)",
      "Write(//$HOME/claude-profiles/*/profile.env)",
      "Edit(//$HOME/claude-profiles/*/tier)",
      "Write(//$HOME/claude-profiles/*/tier)",
      "Edit(//$HOME/claude-profiles/*/tier.src)",
      "Write(//$HOME/claude-profiles/*/tier.src)",
      "Edit(//$HOME/claude-profiles/*/token)",
      "Write(//$HOME/claude-profiles/*/token)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": ["localhost", "127.0.0.1", "api.anthropic.com", "github.com"],
      "strictAllowlist": true,
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": ["~/projects", "~/.npm", "~/Library/pnpm/store/v11"],
      "denyWrite": ["~/projects/agent-hq/config/tiers", "~/claude-profiles/_trust"]
    }
  }
}
